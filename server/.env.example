# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASS=your_database_password
DB_NAME=your_database_name

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret (use a long random string)
JWT_SECRET=your_super_secret_jwt_key_change_this

# Firebase Service Account (optional)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── ZMC Cargo (Kenzy / Canzey API account: KENZYAPI) ───
# Auth: Basic (user+pass) + VToken = SHA256(BasicToken + Timestamp)
# Basic Token is ONLY used to generate VToken — never send it in requests.
#
# ZMC_ENVIRONMENT = default for Orders page (prod on live server, sandbox locally)
ZMC_ENVIRONMENT=sandbox

# PRODUCTION — https://api.zmc-iraq.com/DomesticCargo
ZMC_PROD_URL=https://api.zmc-iraq.com/DomesticCargo
ZMC_PROD_USER=KENZYAPI
ZMC_PROD_PASS=your_prod_api_password
ZMC_PROD_TOKEN=your_prod_basic_token_for_vtoken_hash
ZMC_PROD_COMPANY_ID=

# TEST / SANDBOX — https://mrsltest.zmc-iraq.com/DomesticCargo
ZMC_SANDBOX_URL=https://mrsltest.zmc-iraq.com/DomesticCargo
ZMC_SANDBOX_USER=KENZYAPI
ZMC_SANDBOX_PASS=your_test_api_password
ZMC_SANDBOX_TOKEN=your_test_basic_token_for_vtoken_hash
ZMC_SANDBOX_COMPANY_ID=
